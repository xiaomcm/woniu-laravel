# ── 运行时数据（不入库）────────────────────────────
# 数据库（含安装向导生成的配置表与所有用户数据）
# config/installed.php 同样不入库：里面是本站的数据库连接与 APP_KEY
/storage/database.sqlite
/storage/database.sqlite.*
/config/installed.php
# 用户上传的原始文件与缩略图
/storage/uploads/*
!/storage/uploads/.gitignore
/storage/thumbs/*
!/storage/thumbs/.gitignore
# 运行时缓存 / 会话 / 日志 / 临时文件 / 测试库
/storage/cache/*
!/storage/cache/.gitignore
/storage/sessions/*
!/storage/sessions/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/tmp/*
!/storage/tmp/.gitignore
/storage/testing/*
!/storage/testing/.gitignore
# 兜底：storage 下任何位置的库文件、备份、图片都别想进版本库
/storage/**/*.sqlite
/storage/**/*.sqlite3
/storage/**/*.db
/storage/**/*.sqlite.*
/storage/**/*.bak
/storage/uploads/**/*.jpg
/storage/uploads/**/*.jpeg
/storage/uploads/**/*.png
/storage/uploads/**/*.gif
/storage/uploads/**/*.webp
/storage/uploads/**/*.bmp
/storage/thumbs/**/*.jpg
/storage/thumbs/**/*.jpeg
/storage/thumbs/**/*.png
/storage/thumbs/**/*.gif
/storage/thumbs/**/*.webp
# public 下的软链与直传目录
/public/uploads
/public/thumbs
# 临时调试脚本
/tools/_tmp_*
# WorkBuddy 本地工作记忆（不属于项目代码）
/.workbuddy

# 发版打包产物
/dist
