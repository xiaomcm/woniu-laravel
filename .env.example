# ── WONIU 蜗牛图床 2.0（Laravel 版）环境变量模板 ──────────────
# 复制为 .env 后按需修改：
#   cp .env.example .env
#   php artisan key:generate
#
# 注意：站点真正的配置以「安装向导」生成的 config/installed.php 为准，
# 本文件只是给框架层（.env）兜底用的，详见 INSTALL.md 第五节。

APP_NAME=蜗牛图床
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://127.0.0.1:8102

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# 数据库连接参数实际以 config/installed.php 为准，这里只留一份兜底值，
# 未安装时用得上。选 SQLite 时 DB_DATABASE 留空即可。
DB_CONNECTION=sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# 会话走文件（storage/sessions），会话 Cookie 不加密，已有会话可直接复用
SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 本程序不需要队列与计划任务，同步执行即可
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
